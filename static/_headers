# Cloudflare reads this file to set response headers on static assets.
# Files under /_app/immutable/ have a content hash in their name, so they can be cached forever.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
