{
	"name": "volleyrotations",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pagefind --site build && node scripts/pagefind-precache.js",
		"preview": "wrangler dev --port 4173",
		"deploy": "pnpm run build && wrangler deploy",
		"prepare": "pnpm run i18n && svelte-kit sync || echo \"\"",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url baseLocale --silent",
		"check": "pnpm run i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"og": "node scripts/og-images.ts",
		"test": "playwright test",
		"og": "node scripts/og-images.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@fontsource-variable/plus-jakarta-sans": "^5.3.0",
		"@iconify-json/lucide": "^1.2.152",
		"@inlang/paraglide-js": "^3.2.1",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"bits-ui": "^2.20.6",
		"mdsvex": "^0.12.8",
		"pagefind": "^1.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.6",
		"wrangler": "^4.158.0"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.18.0"
}
